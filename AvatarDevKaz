-- PREVIEW AVATAR
--========================================================--

local function previewAvatar(UserId)

    local Success, Image =
        pcall(function()

            return Players:GetUserThumbnailAsync(
                UserId,
                Enum.ThumbnailType.AvatarThumbnail,
                Enum.ThumbnailSize.Size420x420
            )

        end)

    if not Success or not Image then

        return false

    end

    AvatarImage.Image =
        Image

    local NameSuccess, Username =
        pcall(function()

            return Players:GetNameFromUserIdAsync(
                UserId
            )

        end)

    if NameSuccess then

        PreviewName.Text =
            "@" .. Username

    else

        PreviewName.Text =
            "User ID: " .. tostring(UserId)

    end

    PreviewStatus.Text =
        "Avatar loaded successfully."

    PreviewStatus.TextColor3 =
        COLORS.Green

    return true
end

PreviewButton.MouseButton1Click:Connect(function()

