--========================================================--
-- HELPERS
--========================================================--

local function Corner(Object, Radius)
    local Corner = Instance.new("UICorner")
    Corner.CornerRadius = UDim.new(0, Radius)
    Corner.Parent = Object
    return Corner
end

local function Stroke(Object, Color, Thickness, Transparency)
    local StrokeObject = Instance.new("UIStroke")

    StrokeObject.Color = Color
    StrokeObject.Thickness = Thickness or 1
    StrokeObject.Transparency = Transparency or 0

    StrokeObject.Parent = Object

    return StrokeObject
end

local function Tween(Object, Time, Properties)
    local TweenObject = TweenService:Create(
        Object,
        TweenInfo.new(
            Time,
            Enum.EasingStyle.Quint,
            Enum.EasingDirection.Out
        ),
        Properties
    )

    TweenObject:Play()

    return TweenObject
end

--========================================================--
-- AVATAR FUNCTIONS
--========================================================--

local function clearVisuals(Character)

    for _, Object in ipairs(Character:GetChildren()) do

        if Object:IsA("Accessory")
            or Object:IsA("Hat")
            or Object:IsA("Shirt")
            or Object:IsA("Pants")
            or Object:IsA("ShirtGraphic")
            or Object:IsA("CharacterMesh") then

            Object:Destroy()

        end
    end

    local Head = Character:FindFirstChild("Head")

    if Head then

        for _, Object in ipairs(Head:GetChildren()) do

            if Object:IsA("Decal")
                and Object.Name:lower() == "face" then

                Object:Destroy()

            end
        end
    end

    local BodyColors =
        Character:FindFirstChildOfClass("BodyColors")

    if BodyColors then
        BodyColors:Destroy()
    end
end

local function attachAccessory(Character, Accessory)

    local Handle =
        Accessory:FindFirstChild("Handle")

    if not Handle then
        return
    end

    local TargetAttachment
    local AccessoryAttachment

    for _, Part in ipairs(Character:GetChildren()) do

        if Part:IsA("BasePart") then

            for _, Attachment in ipairs(Part:GetChildren()) do

                if Attachment:IsA("Attachment") then

                    local Matching =
                        Handle:FindFirstChild(Attachment.Name)

                    if Matching
                        and Matching:IsA("Attachment") then

                        TargetAttachment = Attachment
                        AccessoryAttachment = Matching

                        break
                    end
                end
            end
        end

        if TargetAttachment then
            break
        end
    end

    if TargetAttachment
        and AccessoryAttachment then

        Handle.CFrame =
            TargetAttachment.WorldCFrame
            * AccessoryAttachment.CFrame:Inverse()

    else

        local Root =
            Character:FindFirstChild("HumanoidRootPart")

        if Root then
            Handle.CFrame = Root.CFrame
        end
    end

    local Weld =
        Instance.new("WeldConstraint")

    Weld.Part0 = Handle

    Weld.Part1 =
        (TargetAttachment and TargetAttachment.Parent)
        or Character:FindFirstChild("HumanoidRootPart")
        or Character:FindFirstChild("Head")

    Weld.Parent = Handle

    Accessory.Parent = Character
end

local function applyAppearance(UserId)

    local Character =
        LocalPlayer.Character
        or LocalPlayer.CharacterAdded:Wait()

    local Success, Model = pcall(function()

        return Players:GetCharacterAppearanceAsync(UserId)

    end)

    if not Success or not Model then

        return false, "Unable to load that avatar."

    end

    clearVisuals(Character)

    -- Body colors
    local BodyColors =
        Model:FindFirstChildOfClass("BodyColors")

    if BodyColors then

        BodyColors:Clone().Parent =
            Character

    end

    -- Clothing
    for _, Item in ipairs(Model:GetChildren()) do

        if Item:IsA("Shirt")
            or Item:IsA("Pants")
            or Item:IsA("ShirtGraphic") then

            Item:Clone().Parent =
                Character

        end
    end

    -- Accessories
    for _, Accessory in ipairs(Model:GetChildren()) do

        if Accessory:IsA("Accessory")
            or Accessory:IsA("Hat") then

            attachAccessory(
                Character,
                Accessory:Clone()
            )

        end
    end

    -- Face
    local Head =
        Character:FindFirstChild("Head")

    if Head then

        local Face =
            Model:FindFirstChild("face", true)

        if Face and Face:IsA("Decal") then

            Face:Clone().Parent =
                Head

        end
    end

    return true, "Avatar applied successfully."
end

