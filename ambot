--==================================================
-- RIGHT CLICK LOCK
--==================================================

Track(
    UserInputService.InputBegan:Connect(
        function(input, gameProcessed)

            if Removed or gameProcessed then
                return
            end

            if input.UserInputType ==
                Enum.UserInputType.MouseButton2 then

                if IsMouseOverGUI() then
                    return
                end

                HoldingRightClick = true
                Settings.Enabled = true

                -- IMMEDIATE LOCK
                CurrentTarget =
                    GetClosestPlayer()

                UpdateStatus()
            end
        end
    )
)

Track(
    UserInputService.InputEnded:Connect(
        function(input)

            if input.UserInputType ==
                Enum.UserInputType.MouseButton2 then

                HoldingRightClick = false
                Settings.Enabled = false
                CurrentTarget = nil

                if not Removed then
                    UpdateStatus()
                end
            end
        end
    )
)

--==================================================
-- CAMERA LOCK
--==================================================

Track(
    RunService.RenderStepped:Connect(
        function()

            if Removed
                or not Settings.Enabled then

                return
            end

            -- Reacquire immediately if needed

            if not CurrentTarget
                or not IsValidTarget(
                    CurrentTarget
                ) then

                CurrentTarget =
                    GetClosestPlayer()
            end

            if not CurrentTarget then

                LockStatus.Text =
                    "● NO TARGET"

                LockStatus.TextColor3 =
                    Color3.fromRGB(
                        255,
                        170,
                        90
                    )

                return
            end

            local character =
                CurrentTarget.Character

            local head =
                character
                and character:FindFirstChild(
                    "Head"
                )

            if not head then

                CurrentTarget = nil
                return
            end

            -- Recheck wall

            if not HasLineOfSight(
                character,
                head
            ) then

                CurrentTarget =
                    GetClosestPlayer()

                return
            end

            -- Recheck distance

            local localCharacter =
                LocalPlayer.Character

            local localRoot =
                localCharacter
                and localCharacter:FindFirstChild(
                    "HumanoidRootPart"
                )

            local targetRoot =
                character:FindFirstChild(
                    "HumanoidRootPart"
                )

            if localRoot and targetRoot then

                local distance =
                    (
                        localRoot.Position
                        - targetRoot.Position
                    ).Magnitude

                if distance >
                    Settings.MaxDistance then

                    CurrentTarget =
                        GetClosestPlayer()

                    return
                end
            end

            -- INSTANT CAMERA LOCK
            local desiredCFrame =
                CFrame.lookAt(
                    Camera.CFrame.Position,
                    head.Position
                )

            Camera.CFrame =
                Camera.CFrame:Lerp(
                    desiredCFrame,
                    math.clamp(
                        Settings.AimSmoothing,
                        0.01,
                        1
                    )
                )
        end
    )
)

