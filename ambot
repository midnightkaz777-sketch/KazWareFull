--==================================================
-- REMOVE
--==================================================

local function RemoveKazware()

    if Removed then
        return
    end

    Removed = true

    -- Stop lock immediately
    Settings.Enabled = false
    HoldingRightClick = false
    CurrentTarget = nil
    Dragging = false

    -- Hide FOV
    FOVCircle.Visible = false

    -- Disconnect everything
    for _, connection in ipairs(
        Connections
    ) do

        if connection
            and connection.Connected then

            connection:Disconnect()
        end
    end

    table.clear(Connections)

    -- Restore normal camera
    Camera.CameraType =
        Enum.CameraType.Custom

    -- Destroy GUI
    if ScreenGui
        and ScreenGui.Parent then

        ScreenGui:Destroy()
    end

    print("KAZWARE removed.")
end

Track(
    RemoveButton.MouseButton1Click:Connect(
        function()

            RemoveKazware()
        end
    )
)

