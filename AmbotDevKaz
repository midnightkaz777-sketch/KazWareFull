--==================================================
-- REMOVE KAZWARE
--==================================================

local function RemoveKazware()

    if Removed then
        return
    end

    -- Mark as removed FIRST
    Removed = true

    -- Completely stop player lock
    Settings.Enabled = false
    HoldingRightClick = false
    CurrentTarget = nil
    Dragging = false

    -- Hide FOV immediately
    if FOVCircle then
        FOVCircle.Visible = false
    end

    -- Disconnect every connection
    for _, connection in ipairs(Connections) do

        if connection
            and connection.Connected then

            connection:Disconnect()
        end
    end

    table.clear(Connections)

    -- Restore camera
    if Camera then
        Camera.CameraType =
            Enum.CameraType.Custom
    end

    -- Destroy GUI
    if ScreenGui
        and ScreenGui.Parent then

        ScreenGui:Destroy()
    end

    print("================================")
    print("KAZWARE REMOVED")
    print("All connections disconnected.")
    print("Player Lock disabled.")
    print("FOV removed.")
    print("================================")
end

Track(
    RemoveButton.MouseButton1Click:Connect(
        function()

            RemoveKazware()

        end
    )
)

