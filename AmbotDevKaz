local function MakeSection(text, y)

    local label = Instance.new("TextLabel")

    label.Size = UDim2.new(1, -30, 0, 18)
    label.Position = UDim2.fromOffset(15, y)
    label.BackgroundTransparency = 1
    label.Text = text
