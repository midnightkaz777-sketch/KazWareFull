    label.TextSize = 9
    label.TextXAlignment = Enum.TextXAlignment.Left
    label.ZIndex = 102
    label.Parent = Content

    return label
end

local function MakeButton(name, text, x, y, width, height)

    local button = Instance.new("TextButton")

    button.Name = name
    button.Size = UDim2.fromOffset(width, height)
    button.Position = UDim2.fromOffset(x, y)
    button.BackgroundColor3 = Colors.Panel2
    button.BorderSizePixel = 0
    button.Text = text
    button.TextColor3 = Colors.Text
    button.Font = Enum.Font.GothamBold
    button.TextSize = 10
    button.AutoButtonColor = false
    button.ZIndex = 103
    button.Parent = Content

    local corner = Instance.new("UICorner")
    corner.CornerRadius = UDim.new(0, 9)
    corner.Parent = button

    local stroke = Instance.new("UIStroke")
    stroke.Color = Colors.BlueDark
    stroke.Thickness = 1
    stroke.Transparency = 0.15
    stroke.Parent = button

    -- Hover effect

    Track(button.MouseEnter:Connect(function()

        if Removed then
            return
        end

        TweenService:Create(
            button,
            TweenInfo.new(0.15),
            {
                BackgroundColor3 = Color3.fromRGB(18, 40, 60)
            }
        ):Play()

    end))

    Track(button.MouseLeave:Connect(function()

        if Removed then
            return
        end

        if button.BackgroundColor3 ~= Colors.BlueDark then

            TweenService:Create(
                button,
                TweenInfo.new(0.15),
                {
                    BackgroundColor3 = Colors.Panel2
                }
            ):Play()

        end

    end))

    return button
end

