            if Character then

                for _, part in
                    ipairs(
                        Character:GetDescendants()
                    ) do

                    if part:IsA("BasePart") then
                        part.CanCollide = true
                    end

                end

            end

        end

    end
)

RunService.Stepped:Connect(function()

    if not noclip then
        return
    end

    local Character =
        Player.Character

    if not Character then
        return
    end

    for _, part in
        ipairs(
            Character:GetDescendants()
        ) do

        if part:IsA("BasePart") then
            part.CanCollide = false
        end

    end

end)

