local speed = 16
local speedDragging = false

local function UpdateSpeedSlider(mouseX)

    local absolute = SpeedBar.AbsolutePosition
    local size = SpeedBar.AbsoluteSize

    local percent = math.clamp(
        (mouseX - absolute.X) / size.X,
        0,
        1
    )

    speed = math.floor(
        16 + ((100 - 16) * percent)
    )

    SpeedValue.Text = tostring(speed)

    SpeedFill.Size =
        UDim2.new(percent, 0, 1, 0)

    local Character = Player.Character

    local Humanoid =
        Character and
        Character:FindFirstChildOfClass("Humanoid")

    if Humanoid then
        Humanoid.WalkSpeed = speed
    end

end

