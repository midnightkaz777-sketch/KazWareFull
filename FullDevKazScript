        BorderSizePixel = 0
    }, Page)

    Corner(ButtonObject, 8)

    Stroke(
        ButtonObject,
        COLORS.Blue,
        1,
        0.7
    )

    ButtonObject.MouseEnter:Connect(function()

        Tween(ButtonObject, 0.15, {
            BackgroundColor3 = COLORS.BlueDark
        })

    end)

    ButtonObject.MouseLeave:Connect(function()

        Tween(ButtonObject, 0.15, {
            BackgroundColor3 = COLORS.Panel
        })

    end)

    ButtonObject.MouseButton1Click:Connect(function()

        if callback then
            callback()
        end

    end)

    return ButtonObject
end

local function Toggle(Page, text, default, callback)

    local State = default or false

    local Holder = Create("Frame", {
        Size = UDim2.new(1, 0, 0, 45),
        BackgroundColor3 = COLORS.Panel,
        BorderSizePixel = 0
    }, Page)

    Corner(Holder, 8)

    Create("TextLabel", {
        Size = UDim2.new(1, -80, 1, 0),
        Position = UDim2.new(0, 12, 0, 0),
        BackgroundTransparency = 1,
        Text = text,
        TextColor3 = COLORS.Text,
        Font = Enum.Font.GothamMedium,
        TextSize = 12,
        TextXAlignment = Enum.TextXAlignment.Left
    }, Holder)

    local Switch = Create("TextButton", {
        Size = UDim2.new(0, 45, 0, 23),
        Position = UDim2.new(1, -57, 0.5, -11),
        BackgroundColor3 = COLORS.Panel2,
        Text = "",
        AutoButtonColor = false,
        BorderSizePixel = 0
    }, Holder)

    Corner(Switch, 20)

    local Circle = Create("Frame", {
        Size = UDim2.new(0, 17, 0, 17),
        Position = UDim2.new(0, 3, 0.5, -8),
        BackgroundColor3 = COLORS.SubText,
        BorderSizePixel = 0
    }, Switch)

    Corner(Circle, 20)

    local function Update()

        if State then

            Tween(Switch, 0.2, {
                BackgroundColor3 = COLORS.Blue
            })

            Tween(Circle, 0.2, {
                Position = UDim2.new(1, -20, 0.5, -8),
                BackgroundColor3 = COLORS.Text
            })

        else

            Tween(Switch, 0.2, {
                BackgroundColor3 = COLORS.Panel2
            })

            Tween(Circle, 0.2, {
                Position = UDim2.new(0, 3, 0.5, -8),
                BackgroundColor3 = COLORS.SubText
            })

        end

    end

    Switch.MouseButton1Click:Connect(function()

        State = not State

        Update()

        if callback then
            callback(State)
        end

    end)

    Update()

    return Holder
end

