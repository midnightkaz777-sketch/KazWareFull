local function Button(Page, text, callback)

    local ButtonObject = Create("TextButton", {
        Size = UDim2.new(1, 0, 0, 42),
        BackgroundColor3 = COLORS.Panel,
        Text = text,
        TextColor3 = COLORS.Text,
