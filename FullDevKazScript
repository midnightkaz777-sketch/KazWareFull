    Corner(Accent, 4)

    -- Title
    Create("TextLabel", {
        Size = UDim2.new(1, -190, 0, 25),
        Position = UDim2.new(0, 25, 0, 12),
        BackgroundTransparency = 1,
        Text = title,
        TextColor3 = COLORS.Text,
        Font = Enum.Font.GothamBold,
        TextSize = 14,
        TextXAlignment = Enum.TextXAlignment.Left
    }, Card)

    -- Description
    Create("TextLabel", {
        Size = UDim2.new(1, -190, 0, 35),
        Position = UDim2.new(0, 25, 0, 38),
        BackgroundTransparency = 1,
        Text = description,
        TextColor3 = COLORS.SubText,
        Font = Enum.Font.GothamMedium,
        TextSize = 10,
        TextWrapped = true,
        TextXAlignment = Enum.TextXAlignment.Left,
        TextYAlignment = Enum.TextYAlignment.Top
    }, Card)

    -- Execute button
    local ExecuteButton = Create("TextButton", {
        Size = UDim2.new(0, 145, 0, 38),
        Position = UDim2.new(1, -160, 0.5, -19),
        BackgroundColor3 = COLORS.Panel2,
        Text = buttonText,
        TextColor3 = COLORS.Text,
        Font = Enum.Font.GothamBold,
        TextSize = 11,
        AutoButtonColor = false,
        BorderSizePixel = 0
    }, Card)

    Corner(ExecuteButton, 8)

    Stroke(
        ExecuteButton,
        COLORS.Blue,
        1,
        0.45
    )

    ExecuteButton.MouseEnter:Connect(function()

        Tween(
            ExecuteButton,
            0.15,
            {
                BackgroundColor3 =
                    COLORS.BlueDark
            }
        )

    end)

    ExecuteButton.MouseLeave:Connect(function()

        Tween(
            ExecuteButton,
            0.15,
            {
                BackgroundColor3 =
                    COLORS.Panel2
            }
        )

    end)

    ExecuteButton.MouseButton1Click:Connect(function()

        if callback then
            callback()
        end

    end)

    return Card
end

